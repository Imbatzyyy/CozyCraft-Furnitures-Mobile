{
  "name": "cozycraft-furnitures-mobile",
  "version": "1.0.0",
  "author": "CozyCraft Furnitures",
  "homepage": "https://www.cozycraftfurnitures.com",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "storefront:dev": "npm --prefix storefront run dev",
    "storefront:test": "npm --prefix storefront test",
    "storefront:build": "npm --prefix storefront run build",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "zsh './Open CozyCraft in Xcode.command'",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "native:prepare": "bash scripts/prepare-native-web.sh all",
    "native:ios": "bash scripts/prepare-native-web.sh ios",
    "native:android": "bash scripts/prepare-native-web.sh android"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.3.30",
